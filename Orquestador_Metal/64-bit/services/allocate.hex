; ABI v2: RCX=bytes; CF=0,RAX=bloque,EDX=0 o CF=1,RAX=0,EDX=motivo.
; Estado: cursor=9000, complemento=9008, bloqueo persistente=9010.
; Corrupcion de cursor (4) o complemento (6) deja el motivo en el bloqueo.
; Con bloqueo, toda llamada devuelve 5 hasta reinicializacion privada.
@2400
=2400
31 D2
48 83 3C 25 10 90 00 00 00     ; bloqueo previo?
0F 85 3F 01 00 00              ; JNE 2550
4C 8B 04 25 00 90 00 00        ; cursor
49 81 F8 00 00 10 00
0F 82 1A 01 00 00              ; JB 2540
49 81 F8 00 00 18 00
0F 87 0D 01 00 00              ; JA 2540
41 F6 C0 0F
0F 85 03 01 00 00              ; JNZ 2540
4C 8B 0C 25 08 90 00 00        ; complemento
4D 31 C1                       ; XOR R9,R8
49 83 F9 FF                    ; debe ser FFFFFFFFFFFFFFFF
0F 85 0E 01 00 00              ; JNE 2560
48 89 C8
48 85 C0
0F 84 A2 00 00 00              ; JZ 2500
48 83 C0 0F
0F 82 B8 00 00 00              ; JC 2520
48 83 E0 F0
4D 89 C1
49 01 C1
0F 82 A8 00 00 00              ; JC 2520
49 81 F9 00 00 18 00
0F 87 AB 00 00 00              ; JA 2530
4C 89 0C 25 00 90 00 00        ; commit cursor tras todas las comprobaciones
49 F7 D1
4C 89 0C 25 08 90 00 00        ; commit complemento
4C 89 C0
F8 C3
=249D
@2500
B2 01 EB 7C                    ; error 1: cero
@2520
B2 02 EB 5C                    ; error 2: overflow
@2530
B2 03 EB 4C                    ; error 3: espacio insuficiente
@2540
48 C7 04 25 10 90 00 00 04 00 00 00 ; bloquear con motivo 4
B2 04 EB 30
=2550
B2 05 EB 2C                    ; error 5: bloqueo previo, conservar motivo
@2560
48 C7 04 25 10 90 00 00 06 00 00 00 ; bloquear con motivo 6
B2 06 EB 10
=2570
@2580
31 C0 F9 C3
=2584
